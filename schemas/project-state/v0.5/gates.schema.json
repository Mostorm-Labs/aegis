{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mostorm-labs.github.io/aegis/schemas/project-state/v0.5/gates.schema.json",
  "title": "Aegis Gate Registry v0.5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gates", "decisions"],
  "properties": {
    "schema_version": {"const": "0.5"},
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "authority_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "stage": {"type": "string", "pattern": "^P[0-9]{2}$"},
          "authority_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "gate_id", "verdict", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^.+::decision::[0-9]{4}$"},
          "gate_id": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["PASS", "PASS_WITH_FINDINGS", "BLOCKED_IMPLEMENTATION", "BLOCKED_AUTHORITY", "BLOCKED_EVIDENCE", "BLOCKED_ENVIRONMENT"]},
          "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "supersedes": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
