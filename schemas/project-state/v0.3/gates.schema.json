{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mostorm-labs.github.io/aegis/schemas/project-state/v0.3/gates.schema.json",
  "title": "Aegis Gate Registry v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gates"],
  "properties": {
    "schema_version": {"const": "0.3"},
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "verdict", "validity", "authority_ids", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "stage": {"type": "string", "pattern": "^P[0-9]{2}$"},
          "verdict": {"enum": ["PASS", "PASS_WITH_FINDINGS", "BLOCKED_IMPLEMENTATION", "BLOCKED_AUTHORITY", "BLOCKED_EVIDENCE", "BLOCKED_ENVIRONMENT"]},
          "validity": {"enum": ["current", "needs_review", "stale"]},
          "authority_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    }
  }
}
