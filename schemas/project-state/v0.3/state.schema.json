{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mostorm-labs.github.io/aegis/schemas/project-state/v0.3/state.schema.json",
  "title": "Aegis Generated Project State v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generator_version", "manifest_digest", "active_stage", "earliest_untrusted_layer", "blocking_findings", "stale_authorities", "needs_review_authorities", "stale_gates", "needs_review_gates", "historical_gates", "blocking_gates", "awaiting_integrations", "integration_applicability", "recommended_next_stage", "recommended_handoff"],
  "properties": {
    "schema_version": {"const": "0.3"},
    "generator_version": {"const": "0.3"},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "active_stage": {"type": ["string", "null"]},
    "earliest_untrusted_layer": {"type": ["string", "null"]},
    "blocking_findings": {"type": "array", "items": {"type": "string"}},
    "stale_authorities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "needs_review_authorities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "stale_gates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "needs_review_gates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "historical_gates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "blocking_gates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "awaiting_integrations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "integration_applicability": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["integration_id", "applicability"],
        "properties": {
          "integration_id": {"type": "string", "minLength": 1},
          "applicability": {"enum": ["current", "needs_review", "stale", "historical"]}
        }
      }
    },
    "recommended_next_stage": {"type": ["string", "null"]},
    "recommended_handoff": {"type": ["string", "null"]}
  }
}
