{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mostorm-labs.github.io/aegis/schemas/project-state/v0.2/authorities.schema.json",
  "title": "Aegis Authority Registry v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorities", "impact_reviews"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "kind", "version", "status", "ref", "depends_on"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "status": {"enum": ["Proposed", "Current", "Superseded", "Historical"]},
          "ref": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "supersedes": {"type": "string", "minLength": 1},
          "change_class": {"enum": ["clarification", "compatible", "semantic", "breaking", "ownership"]}
        }
      }
    },
    "impact_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_authority", "dependent_authority", "outcome", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_authority": {"type": "string", "minLength": 1},
          "dependent_authority": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["unaffected", "needs_review", "stale"]},
          "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    }
  }
}
